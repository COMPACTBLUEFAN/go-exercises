Функция Привет(ПеременнаяНекая):
    Сообщить("Привет, " + ПеременнаяНекая)

Функция Квадрат(число):
    Вернуть число * число

Переменная = Ввод("Как тебя зовут? ")
Привет(Переменная)

Если Длина(Переменная) > 5:
    Сообщить("У тебя длинное имя!")
Иначе:
    Сообщить("У тебя короткое имя!")

Число = Целое(Ввод("Введи число для возведения в квадрат: "))
Сообщить("Квадрат твоего числа: " + Строка(Квадрат(Число)))