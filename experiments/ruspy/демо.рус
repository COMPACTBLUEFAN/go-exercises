// ─── 9. КЛАССЫ (ООП) ───
Сообщить("═══ Классы (ООП на русском!) ═══")

Класс Разработчик:
    Функция __создать__(сам, имя, язык):
        сам.имя = имя
        сам.язык = язык
        сам.проекты = []

    Функция __строка__(сам):
        Вернуть f"👨‍💻 {сам.имя} ({сам.язык})"

    Функция добавитьПроект(сам, название):
        сам.проекты.добавить(название)
        Сообщить(f"  📌 Проект '{название}' добавлен к {сам.имя}")

    Функция показатьПроекты(сам):
        Если Длина(сам.проекты) == 0:
            Сообщить(f"  {сам.имя}: проектов пока нет")
        Иначе:
            Сообщить(f"  Проекты {сам.имя}:")
            Для проект В сам.проекты:
                Сообщить(f"    • {проект}")

дев1 = Разработчик("Дмитрий", "Go")
дев2 = Разработчик("Алиса", "Python")

Сообщить(дев1)
Сообщить(дев2)

дев1.добавитьПроект("RusPy Транслятор")
дев1.добавитьПроект("gRPC Микросервис")
дев2.добавитьПроект("ML Pipeline")

дев1.показатьПроекты()
дев2.показатьПроекты()
Сообщить()

// ─── 10. ФУНКЦИОНАЛЬНОЕ ПРОГРАММИРОВАНИЕ ───
Сообщить("═══ Функциональное программирование ═══")

числа = [1, -5, 3, -2, 7, -4, 10, 0]
Сообщить("Исходные числа:", числа)

// Фильтрация
положительные = Список(Фильтр(Лямбда х: х > 0, числа))
Сообщить("Положительные:", положительные)

// Маппинг  
квадраты = Список(Карта(Лямбда х: х ** 2, числа))
Сообщить("Квадраты:", квадраты)

// Сумма, Мин, Макс
Сообщить(f"Сумма: {Сумма(числа)}, Мин: {Мин(числа)}, Макс: {Макс(числа)}")
Сообщить()

